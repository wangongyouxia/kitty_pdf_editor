<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="150.0.7869" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
  </ItemGroup>

  <!-- Bundle CJK fonts so newly-inserted Chinese text (watermark, insert-
       text) renders on machines without these fonts installed. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\app\fonts\msyh.ttc">
      <LogicalName>KittyPdf.Core.Fonts.msyh.ttc</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\app\fonts\msyhbd.ttc">
      <LogicalName>KittyPdf.Core.Fonts.msyhbd.ttc</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\app\fonts\simsun.ttc">
      <LogicalName>KittyPdf.Core.Fonts.simsun.ttc</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\app\fonts\simhei.ttf">
      <LogicalName>KittyPdf.Core.Fonts.simhei.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\app\fonts\simkai.ttf">
      <LogicalName>KittyPdf.Core.Fonts.simkai.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\app\fonts\simfang.ttf">
      <LogicalName>KittyPdf.Core.Fonts.simfang.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
